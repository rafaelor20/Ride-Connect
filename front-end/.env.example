# ==============================================================================
# RIDE CONNECT - FRONTEND (.env.example)
# Exemplo geral das variaveis de ambiente necessarias para o frontend
# ==============================================================================

# URL da API Backend (use http://localhost:8080/api no Docker Compose ou http://localhost:5000 em dev local)
VITE_API_BASE_URL=http://localhost:8080/api

# Chave da API do Google Maps / Routes
VITE_API_GOOGLE_API_KEY=sua_chave_google_aqui