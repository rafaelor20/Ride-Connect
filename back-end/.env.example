# ==============================================================================
# RIDE CONNECT - BACKEND (.env.example)
# Exemplo geral das variaveis de ambiente necessarias para o backend
# ==============================================================================

PORT=5000

# Configuracoes de conexao com o PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ride-connect

# Chave secreta JWT para autenticacao
JWT_SECRET=top_secret

# URL do banco de dados PostgreSQL
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Configuracoes opcionais de e-mail
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_CONTACTUS=
FRONTEND_URL=

# Chave da API do Google (Routes & Maps)
GOOGLE_API_KEY=sua_chave_google_aqui