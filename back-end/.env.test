# ==============================================================================
# RIDE CONNECT - BACKEND (.env.test)
# Arquivo funcional ativo para execucao dos testes automatizados (Jest)
# ==============================================================================

PORT=5000

# Conexao com o banco de dados de testes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ride-connect-test

# Chave secreta JWT para testes
JWT_SECRET=top_secret_test

# URL do banco de dados para os testes
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Configuracoes de e-mail para testes
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=test
MAIL_PASSWORD=test
MAIL_FROM=test@rideconnect.com
MAIL_CONTACTUS=contact@rideconnect.com
FRONTEND_URL=

# Chave da API do Google para testes
GOOGLE_API_KEY=sua_chave_google_aqui
