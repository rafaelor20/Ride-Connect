# ==============================================================================
# RIDE CONNECT - BACKEND (.env.local)
# Modelo / Exemplo de configuracao para execucao local direta via npm run dev
# ==============================================================================

PORT=5000

# Configuracoes de conexao com o PostgreSQL local (porta 5433 exposta pelo container ou 5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ride-connect

# Chave secreta JWT para autenticacao
JWT_SECRET=top_secret

# URL do banco de dados montada para o host local
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Configuracoes de e-mail (opcional)
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_CONTACTUS=
FRONTEND_URL=

# Chave da API do Google (Routes & Maps)
GOOGLE_API_KEY=sua_chave_google_aqui
