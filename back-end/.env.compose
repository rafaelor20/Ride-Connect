# ==============================================================================
# RIDE CONNECT - BACKEND (.env.compose)
# Modelo / Exemplo de configuracao para execucao via Docker Compose
# ==============================================================================

PORT=5000

# Configuracoes de conexao com o PostgreSQL no container Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ride-connect

# Chave secreta JWT para autenticacao
JWT_SECRET=top_secret

# URL do banco de dados montada para o ambiente Docker Compose
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Configuracoes de e-mail (opcional)
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_CONTACTUS=

# Chave da API do Google (Routes & Maps)
GOOGLE_API_KEY=sua_chave_google_aqui
